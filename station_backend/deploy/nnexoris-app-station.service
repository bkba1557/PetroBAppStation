[Unit]
Description=NNEXORIS Station Employee Application API
After=network.target postgresql.service nnexoris-cloud.service
Requires=postgresql.service

[Service]
Type=simple
User=nnexoris
Group=nnexoris
WorkingDirectory=/opt/nnexoris-app-station
Environment=PYTHONPATH=/opt/nnexoris-cloud:/opt/nnexoris-app-station
EnvironmentFile=/etc/nnexoris/nnexoris-cloud.env
EnvironmentFile=/etc/nnexoris/nnexoris-app-station.env
ExecStart=/opt/nnexoris-cloud/.venv/bin/gunicorn --bind 127.0.0.1:18092 --workers 2 --threads 4 --timeout 120 --access-logfile - --error-logfile - wsgi:app
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/nnexoris-app-station

[Install]
WantedBy=multi-user.target
